#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase client configs (secrets, A-40) — кладутся через CI secrets / локально
android/app/google-services.json
android/app/src/**/google-services.json
ios/Runner/GoogleService-Info.plist
ios/Runner/GoogleService-Info-Dev.plist
ios/Runner/GoogleService-Info-Prod.plist

# Ключи SUPARBASE
/key/*

# Временные файлы SUPABASE
/supabase/.temp/*

# Node-зависимости tools-скриптов
/tools/node_modules/

# Сгенерированный Flutter-файл (devtools)
/devtools_options.yaml
# Widget Preview related
.widget_preview/
